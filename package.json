{
  "name": "biz-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "通用业务流程 Agent —— 基于 Pi (pi-agent-core) 的可配置企业业务智能体平台",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
