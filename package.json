    "live-check": "tsx scripts/live-check.ts",
    "persist-check": "tsx scripts/persist-check.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:check": "tsx scripts/db-check.ts",
    "typecheck": "tsc --noEmit",
    "web:dev": "vite --config client/vite.config.js",
    "web:build": "vite build --config client/vite.config.js",
    "ui:e2e": "node scripts/ui-redesign-e2e.mjs",
    "ui:e2e:previous": "node scripts/ui-e2e.mjs",
    "ui:actions": "node scripts/ui-actions-selftest.mjs",
    "verify": "tsx scripts/selftest.ts",
    "kb:selftest": "tsx scripts/kb-selftest.ts",
    "kb:pg:selftest": "tsx scripts/kb-pg-selftest.ts",
    "auth:selftest": "tsx scripts/auth-selftest.ts",
    "models:selftest": "tsx scripts/models-selftest.ts",
    "mcp:selftest": "tsx scripts/mcp-selftest.ts",
    "agents:selftest": "tsx scripts/agents-selftest.ts",
    "agent-groups:selftest": "tsx scripts/agent-groups-storage-selftest.ts",
    "agent-groups:moderation:selftest": "tsx scripts/agent-group-moderation-selftest.ts",
    "agent-groups:e2e": "node scripts/agent-group-moderation-e2e.mjs",
    "plugins:selftest": "tsx scripts/plugins-selftest.ts",
    "contracts:selftest": "tsx scripts/session-contract-selftest.ts",
    "contracts:e2e": "node scripts/contracts-e2e.mjs",
    "pi:selftest": "tsx scripts/pi-runtime-adapter-selftest.ts",
    "smoke:agents": "tsx scripts/smoke-agents.ts",
    "obs:selftest": "tsx scripts/observability-selftest.ts",
    "im:selftest": "tsx scripts/im-selftest.ts",
    "wecom:selftest": "tsx scripts/wecom-selftest.ts && tsx scripts/wecom-outbound-selftest.ts",
    "smoke:auth": "tsx scripts/smoke-auth.ts",
    "smoke:mcp": "tsx scripts/smoke-mcp.ts",
    "smoke:openapi": "tsx scripts/smoke-openapi.ts",
    "smoke:monitor": "tsx scripts/smoke-monitor.ts",
    "smoke:im": "tsx scripts/smoke-im.ts",
    "smoke:wecom": "tsx scripts/smoke-wecom.ts",
    "ui-check": "node scripts/ui-check.mjs",
    "ui-dom-check": "node scripts/ui-dom-check.mjs",
    "ui-shot": "node scripts/ui-shot.mjs",
    "smoke": "tsx scripts/smoke.ts",
    "demo:ticket": "tsx examples/ticket.demo.ts",
    "demo:data": "tsx examples/data.demo.ts",
    "demo:approval": "tsx examples/approval.demo.ts",
    "demo:real": "tsx examples/real-model.ts",
    "code": "tsx src/cli/code.ts",
    "code:selftest": "tsx scripts/code-selftest.ts",
    "pi:cli-selftest": "tsx scripts/pi-cli-session-selftest.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "mammoth": "^1.13.0",
    "naive-ui": "^2.45.3",
    "pg": "^8.23.1",
    "unpdf": "^1.9.1",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "jszip": "^3.10.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.6"
  }
}
