# 把本文件复制成 biz-agent/.env 并填入你的 key。
# .env 已在 .gitignore 里，不会被提交。

# ---------- 方式一：直接填某个内置 provider 的 key（最简单） ----------
DEEPSEEK_API_KEY=

# 可选：指定具体模型（不填则用该 provider 的默认模型）
# DeepSeek 可选：deepseek-v4-pro / deepseek-flash
# LLM_MODEL=deepseek-v4-pro

# ---------- 方式二：自定义 OpenAI 兼容端点（中转、自建网关、Ollama、vLLM） ----------
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://your-gateway.example.com/v1
# LLM_API_KEY=sk-xxx

# ---------- 传输层 ----------
# LLM_TIMEOUT_MS=120000
# LLM_MAX_RETRIES=3

# ---------- 存储 ----------
# 会话数据库路径，默认 biz-agent/data/biz-agent.db
# DB_PATH=./data/biz-agent.db

# ---------- 服务 ----------
# PORT=4317
